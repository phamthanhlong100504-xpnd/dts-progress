# Example only. Maven and Spring Boot do not automatically load .env files.
# Supply credentials locally; keep the completed .env outside Git.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083
DB_HOST=localhost
DB_PORT=5434
DB_EXTERNAL_PORT=5434
DB_NAME=dts_progress
DB_USERNAME=postgres
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=
JWT_ISSUER=dts-identity-service
IDENTITY_SERVICE_URL=http://localhost:8081
PRACTICE_SERVICE_URL=http://localhost:8087
EXAM_PROGRESS_INTERNAL_KEY=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_ENABLED=false
EUREKA_URI=http://localhost:8761/eureka/
# Let Flyway SQL perform schema changes; Hibernate checks the migrated schema.
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
